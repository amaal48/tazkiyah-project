{
  "crons": [
    {
      "path": "/api/run-screening",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/notify-questions",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/update-calendar",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/publish-weekly-report?slot=10",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/publish-weekly-report?slot=11",
      "schedule": "0 11 * * 1"
    }
  ],
  "functions": {
    "api/run-screening.js": {
      "maxDuration": 60
    },
    "api/update-calendar.js": {
      "maxDuration": 60
    }
  }
}
